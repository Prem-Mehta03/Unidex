# Copy this file to ".env" and fill in the values. ".env" is git-ignored.
# Never paste real keys into chat, issues, or commits.

# --- Used from Stage 1 ---------------------------------------------------
# Path of the SQLite database file (relative to the repo root).
UNIDEX_DB_PATH=data/unidex.db
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
UNIDEX_LOG_LEVEL=INFO

# --- Used from Stage 3 (optional: the app works without them) -----------
# Key from aistudio.google.com (personal Gmail, no billing enabled).
GEMINI_API_KEY=
# Copy the exact model id shown in AI Studio.
GEMINI_MODEL=
# Free-tier limits you observed in AI Studio.
LLM_REQUESTS_PER_MINUTE=5
LLM_REQUESTS_PER_DAY=20

# --- Used from Stage 6 (login) -------------------------------------------
# Leave these blank while developing: the site is then open and no login is asked for.
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string, at least 32 characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Only accounts on these domains may sign in (comma-separated, no @).
ALLOWED_EMAIL_DOMAIN=goa.bits-pilani.ac.in
# Optional: extra individual addresses allowed in (comma-separated), e.g. your own Gmail while
# testing. Exact match only. Remove before sharing the site widely.
ALLOWED_EMAILS=
# Set to true on the deployed site: the server then refuses to start unless the three
# settings above are filled in, so a typo can never leave the site open.
UNIDEX_REQUIRE_LOGIN=false
# The address people type, e.g. https://unidex.onrender.com (no trailing slash). Needed on
# a hosted site so the Google redirect address is right behind the host's proxy.
UNIDEX_PUBLIC_URL=

# --- Used from Stage 6b (reading the Drive folders) ----------------------
# A SECOND OAuth client of type "Desktop app" (same Google Cloud project). Used only by
# scripts/drive_login.py and scripts/sync_drive.py on your own computer.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
# Where the saved read-only Drive sign-in is kept (git-ignored).
DRIVE_TOKEN_PATH=data/drive_token.json

# --- Hosting (see docs/deploy.md) ---
# Copies of reports and search logs are posted here so they survive restarts on a free host.
# Both or neither. The URL is the Apps Script web app address; the secret is any long random
# string that you also store as the script property SECRET.
# EVENT_WEBHOOK_URL=
# EVENT_WEBHOOK_SECRET=
